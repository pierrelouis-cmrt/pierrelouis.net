    <div class="post-lightbox" data-post-lightbox hidden>
      <div
        class="post-lightbox__dialog"
        role="dialog"
        aria-modal="true"
        aria-label="Expanded article image"
      >
        <button
          class="post-lightbox__backdrop"
          type="button"
          data-post-lightbox-close
          aria-label="Close expanded image"
        ></button>
        <figure class="post-lightbox__figure">
          <img class="post-lightbox__image" data-post-lightbox-image alt="" />
          <figcaption
            class="post-lightbox__nav"
            data-post-lightbox-nav
            aria-label="Article image navigation"
          >
            <button class="post-lightbox__nav-button" type="button" data-post-lightbox-prev aria-label="Previous image">←</button>
            <span class="post-lightbox__counter" data-post-lightbox-counter aria-live="polite"></span>
            <button class="post-lightbox__nav-button" type="button" data-post-lightbox-next aria-label="Next image">→</button>
          </figcaption>
        </figure>
        <button class="post-lightbox__close" type="button" data-post-lightbox-close aria-label="Close expanded image">Close</button>
      </div>
    </div>
